# AutoMedic Mission Control — env template
# Copy to .env.local for local overrides.

# Mock mode (default): polls /mock/state.json; break/scan/reset are no-ops that resolve { ok: true, mock: true }
# Live mode: set VITE_USE_MOCK=false and point BASE_URL at the n8n webhook base (no trailing slash).
VITE_USE_MOCK=true
VITE_AUTOMEDIC_BASE_URL=https://kaviya-aj.app.n8n.cloud/webhook
VITE_AUTOMEDIC_SECRET=automedic-demo-secret
